      "order": 30,
      "name": "Pro 100 刀 / 5x",
      "spec": "Pro 100 美元额度 · 5 倍用量",
      "note": "可覆盖 · 可续费",
      "band": {
        "min": 300,
        "max": 1200
      }
    },
    {
      "key": "pro-20x",
      "group": "pro",
      "order": 31,
      "name": "Pro 200 刀 / 20x",
      "spec": "Pro 200 美元额度 · 20 倍用量",
      "note": "部分渠道标 10x，属同档",
      "band": {
        "min": 600,
        "max": 2000
      }
    },
    {
      "key": "pro-500",
      "group": "pro",
      "order": 32,
      "name": "Pro 500 刀 / 25x·50x",
      "spec": "Pro Max · 500 美元额度",
      "note": "",
      "band": {
        "min": 2000,
        "max": 6000
      }
    },
    {
      "key": "pro-acc",
      "group": "pro",
      "order": 33,
      "name": "Pro 成品号",
      "spec": "直接发 Pro 账号 · 临期 / 速刷",
      "note": ""
    },
    {
      "key": "team-seat",
      "group": "team",
      "order": 40,
      "name": "Team 车位（月权益）",
      "spec": "车位 · 可与 Plus 并存 · 质保订阅",
      "note": "补额度用，不是独立账号",
      "band": {
        "min": 60,
        "max": 400
      }
    },
    {
      "key": "team-account",
      "group": "team",
      "order": 41,
      "name": "Team 账号 / 席位",
      "spec": "1x / 5x Team · 5 小时额度限制 · 车主定时踢人",
      "note": "拼车性质，随时可能被踢；商品名里常写「几点踢」"
    },
    {
      "key": "codex-sms-once",
      "group": "sms",
      "order": 50,
      "name": "Codex 接马 · 单次",
      "spec": "5 秒 ~ 25 分钟有效 · 多为美国实卡",
      "note": "过一次验证用，多数标 100% 成功"
    },
    {
      "key": "codex-sms-long",
      "group": "sms",
      "order": 51,
      "name": "Codex 接马 · 长效",
      "spec": "20 ~ 90 天有效 · 可绑 2~3 个号",
      "note": "只质保「来码」，不保证绑定成功"
    },
    {
      "key": "codex-sms-pack",
      "group": "sms",
      "order": 52,
      "name": "Codex 接马 · 次数包",
      "spec": "10 次 / 50 次 CDK · 可 API 对接",
      "note": "量大或跑自动化"
    },
    {
      "key": "codex-credit",
      "group": "sms",
      "order": 53,
      "name": "Codex 额度 / 邀请",
      "spec": "Credits 充值 · 好友邀请加额度",
      "note": "补额度，不是订阅"
    },
    {
      "key": "api-credit",
      "group": "pro",
      "order": 34,
      "name": "API 中转额度",
      "spec": "第三方中转站余额 / 兑换码 · 按刀计价",
      "note": "不是官方订阅，是第三方中转站的余额；按面额折算，单价通常低于官方",
      "hidden": true
    }
