  "products": [
    {
      "key": "plus-daily",
      "group": "account",
      "order": 10,
      "name": "Plus 日抛 / 未接马",
      "spec": "未接短信 · 质保首登 · 30 分钟~1 小时验号",
      "note": "最便宜的一档，只保首登，超时不退不换；日抛号当天可能失效"
    },
    {
      "key": "plus-ready",
      "group": "account",
      "order": 11,
      "name": "Plus 已接马",
      "spec": "已过短信验证 · 可直接登录网页 / Codex",
      "note": "比未接马贵 3~5 元，省掉自己接码这一步"
    },
    {
      "key": "plus-proxy",
      "group": "account",
      "order": 12,
      "name": "Plus 反代专用",
      "spec": "CPA / sub2api 反代 · 可不发账密",
      "note": "只给 json / RT，用于反代池，走量"
    },
    {
      "key": "plus-long",
      "group": "account",
      "order": 13,
      "name": "Plus 长质保",
      "spec": "质保 1 天 ~ 30 天 · 越南实卡 / 一卡一指纹",
      "note": "贵，但掉订阅可补；适合长期用"
    },
    {
      "key": "plus-quota",
      "group": "account",
      "order": 14,
      "name": "Plus 满额度 / 重置卡",
      "spec": "满额度 · 附带 1~3 张重置卡",
      "note": "额度不够或降智时用重置卡恢复"
    },
    {
      "key": "plus-student",
      "group": "account",
      "order": 15,
      "name": "Plus 学生认证",
      "spec": "学生认证 / 半价资格号 · 人工绑卡",
      "note": "交付的是资格，不是会员"
    },
    {
      "key": "plus-selfopen",
      "group": "account",
      "order": 16,
      "name": "Plus 自助开通",
      "spec": "自备账号 · 自助扫码 / 开通",
      "note": "需要自己提供账号，站点只给开通通道"
    },
    {
      "key": "plus-other",
      "group": "account",
      "order": 17,
      "name": "Plus 成品号（其他）",
      "spec": "半成品 / 其他渠道 · 未归类到上面几种",
      "note": ""
    },
    {
      "key": "openai-free",
      "group": "account",
      "order": 18,
      "name": "ChatGPT 普号 / Free 号",
      "spec": "免费号 · 无会员 · 可用于接码/注册",
      "note": "0.1 元级，仅作注册基底或反代"
    },
    {
      "key": "plus-charge-ph",
      "group": "charge",
      "order": 20,
      "name": "Plus 代充 · 菲区 CDK",
      "spec": "菲区卡充 · 质保订阅 30 天 · 多数不可覆盖老号",
      "note": "主流代充档，12x 元",
      "band": {
        "min": 80,
        "max": 250
      }
    },
    {
      "key": "plus-charge-bill",
      "group": "charge",
      "order": 21,
      "name": "Plus 代充 · 带官方账单",
      "spec": "官方直充 · 带账单 · 可开票",
      "note": "比菲区贵 1~10 元，售后凭据更硬",
      "band": {
        "min": 80,
        "max": 300
      }
    },
    {
      "key": "plus-charge-ios",
      "group": "charge",
      "order": 22,
      "name": "Plus 代充 · iOS / 美区",
      "spec": "iOS 渠道 CDK · 可覆盖 · 可续费",
      "note": "能覆盖老号，安卓也可用",
      "band": {
        "min": 80,
        "max": 300
      }
    },
    {
      "key": "plus-charge-other",
      "group": "charge",
      "order": 23,
      "name": "Plus 代充 · 其他渠道",
      "spec": "官方直充 / 其他地区 · 未细分的代充",
      "note": "",
      "band": {
        "min": 80,
        "max": 300
      }
    },
    {
      "key": "plus-go",
      "group": "charge",
      "order": 24,
      "name": "ChatGPT Go",
      "spec": "Go 档月卡 · 额度低于 Plus",
      "note": "适合轻量使用",
      "band": {
        "min": 20,
        "max": 150
      }
    },
    {
      "key": "plus-year",
